# 프런트엔드
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id
# 비워 두면 개발 화면의 호스트(localhost 또는 127.0.0.1)와 같은 호스트의 8000 포트를 사용합니다.
VITE_API_BASE_URL=

# 백엔드
MOIS_SERVICE_KEY=your_data_go_kr_service_key
# SGIS 서비스 ID와 보안 Key로 실행 시 액세스 토큰을 자동 발급합니다.
SGIS_CONSUMER_KEY=your_sgis_service_id
SGIS_CONSUMER_SECRET=your_sgis_security_key
# 직접 발급한 임시 토큰을 쓸 때만 설정합니다(일반적으로 비워둡니다).
SGIS_ACCESS_TOKEN=
VWORLD_API_KEY=your_vworld_api_key
VWORLD_API_DOMAIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# 인증과 요청 횟수 제한을 적용하기 전에는 실시간 원천 API 프록시를 비활성화합니다.
ENABLE_LIVE_MOIS_PROXY=false
# 관리자 인증. 평문 비밀번호가 아니라 `python -m app.services.admin_auth` 결과를 넣습니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# 운영 HTTPS에서는 true로 설정합니다. 로컬 http 개발은 false로 둡니다.
ADMIN_COOKIE_SECURE=false
# 전국 인구밀도 계산용 국토면적(km²). 기본값은 KOSIS 2025 기준값입니다.
NATIONAL_AREA_KM2=100472.4
