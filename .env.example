# Frontend
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Backend
MOIS_SERVICE_KEY=your_data_go_kr_service_key
# SGIS 서비스 ID와 보안 Key로 실행 시 액세스 토큰을 자동 발급합니다.
SGIS_CONSUMER_KEY=your_sgis_service_id
SGIS_CONSUMER_SECRET=your_sgis_security_key
# 직접 발급한 임시 토큰을 쓸 때만 설정합니다(일반적으로 비워둡니다).
SGIS_ACCESS_TOKEN=
VWORLD_API_KEY=your_vworld_api_key
VWORLD_API_DOMAIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Keep the live upstream proxy disabled unless it is protected by authentication and rate limiting.
ENABLE_LIVE_MOIS_PROXY=false
# 전국 인구밀도 계산용 국토면적(km²). 기본값은 KOSIS 2025 기준값입니다.
NATIONAL_AREA_KM2=100472.4
