# 서버에서 이 파일을 deploy.env로 복사합니다. deploy.env는 커밋하지 않습니다.
SITE_DOMAIN=map.example.com
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id
# 서버 실행에만 필요한 값입니다. deploy.env는 서버에만 보관합니다.
ADMIN_USERNAME=
# Compose가 PBKDF2 해시의 $ 구분자를 보존하도록 작은따옴표로 감쌉니다.
ADMIN_PASSWORD_HASH=''
ADMIN_SESSION_SECRET=
MOIS_SERVICE_KEY=
