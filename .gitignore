# 로그
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 브라우저용 GeoJSON 생성 파일(npm run dev/build에서 생성)
public/data/*.render.geojson

# Python 가상환경과 생성된 바이트코드
server/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경 변수와 API 키
.env
.env.*
deploy.env
deploy.example.env

# 작업 중 임시 산출물과 개인 문서는 저장소에 올리지 않습니다.
.docx_work/
_workspace/
tmp/
server/tmp*/
/한솔PNS_*.md

# 로컬 SQLite DB, 부속 파일, 백업 및 가져오기 결과
server/data/

# 로컬 코드 백업(디스크에만 보관하고 공개하지 않음)
server/app/models.py.bak

# 개발·배포 문서는 로컬에 보관하고 README 이미지만 공개
/docs/*
!/docs/images/

# 편집기 디렉터리와 파일
.vscode/*
!.vscode/extensions.json
.idea
